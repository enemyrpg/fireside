# Copy to .env and adjust. Never commit .env.
# The systemd service reads this file too (docs/self-hosting.md, "Autostart").
# Keep to plain lines of the form KEY=value, with comments on their own lines,
# as below.

# Every variable is optional. Empty values use the default.

# Network interface the server listens on. Default: 127.0.0.1.
# Docker ignores this: the container always listens on 127.0.0.1.
# Keep 127.0.0.1. Any other value makes the server reachable from other
# machines. For access from outside, use Cloudflare Tunnel, which connects to
# 127.0.0.1 (docs/tunnel.md).
HOST=127.0.0.1

# Port for the API and dashboard (1–65535). Default: 3100.
# Docker ignores this: to change the port in Docker, set FIRESIDE_PORT below.
# Setting PORT alone leaves the container on 3100, and if that port is taken
# it keeps restarting with EADDRINUSE.
PORT=3100

# --- Docker only (read by Docker Compose, not by the server) -----------------
# Docker ignores HOST, PORT, DATA_DIR and BACKUP_DIR in this file. Change these
# instead (the folder inside the container is always /data, with backups in
# /data/backups).

# Host folder with the database, mounted at /data in the container. Relative
# to docker-compose.yml. Must exist before the first start. Default: ./data
# FIRESIDE_DATA_PATH=./data

# Port on 127.0.0.1 for the dashboard and the plugin, the Docker version of
# PORT. Change this to run Fireside in Docker on another port. It is the only
# port variable Compose reads: PORT is ignored in Docker. Default: 3100.
# FIRESIDE_PORT=3100

# User and group the server (and cloudflared) run as. Must own
# FIRESIDE_DATA_PATH and the tunnel token file. Use your own (`id -u`,
# `id -g`) to read the data folder and backups without sudo. Default: 1000.
# FIRESIDE_UID=1000
# FIRESIDE_GID=1000

# Build the image from this checkout instead of pulling the release from GHCR
# (docker-compose.build.yml), then `docker compose up -d --build`. Unset: the
# release image pinned in docker-compose.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# Tag for the image built with docker-compose.build.yml. Give a second clone
# its own (e.g. fireside:test), so building there doesn't replace the image
# your instance uses. Default: fireside:local
# FIRESIDE_LOCAL_IMAGE=fireside:local

# --- Remote access: Cloudflare Tunnel (docs/tunnel.md) ----------------------
# Off by default. Leave all of this unset unless you are setting up the tunnel
# as described in docs/tunnel.md. Fireside must be in login mode first (a
# user with a password), or the dashboard's API answers 403 to every request
# through the tunnel. The plugin's ingest works either way: it needs a key.

# The address the dashboard is reached at from outside, e.g.
# https://dashboard.example.com (scheme and host only). Only used in login mode,
# where it is the one host besides localhost the dashboard answers to, and
# for invite and password reset links. Must be https (http only for
# localhost), or the server refuses to start: the login cookie is Secure.
# With TRUSTED_PROXY set, this host only answers through the tunnel.
# Default: unset.
# PUBLIC_URL=https://dashboard.example.com

# The reverse proxy in front of the server. Only value: cloudflare
# (Cloudflare Tunnel, with cloudflared on this machine connecting to
# 127.0.0.1). Then, in login mode, requests from loopback with Cloudflare's
# headers are allowed on the PUBLIC_URL host, and the client IP for rate limits
# and logs is read from CF-Connecting-IP. Needs an https PUBLIC_URL. If no user
# has a password, the server warns at startup: in local mode the dashboard's
# API refuses every request through the tunnel. Unset: the dashboard refuses
# proxy headers and never reads them.
# Default: unset.
# TRUSTED_PROXY=cloudflare

# Docker only: also start (and pull, and update) the cloudflared service with
# the usual `docker compose pull --ignore-buildable` and `docker compose up -d`.
# Without it, Compose skips the service, and an update leaves the tunnel on an
# old image.
# Read by Docker Compose, not by the server. Default: unset (no tunnel).
# COMPOSE_PROFILES=tunnel

# Docker only: the file with the tunnel token, mode 0600, owned by the user in
# FIRESIDE_UID (default 1000). Never put the token itself in this file. Read by
# Docker Compose. Without Docker, scripts/systemd/install.sh --tunnel reads
# ./secrets/tunnel-token. Default: ./secrets/tunnel-token.
# FIRESIDE_TUNNEL_TOKEN_FILE=./secrets/tunnel-token

# Most users this instance may have, counting disabled ones. Checked when an
# admin makes an invite and again when the invite is used, not by
# `pnpm cli users create`.
# Default: unset (no limit).
# MAX_USERS=10

# IANA time zone name used for grouping by day and week (screen time, weekly
# summaries), e.g. Europe/Oslo. Offsets like +01:00 are not accepted.
# Timestamps are always stored in UTC. Default: UTC.
TZ=Europe/Oslo

# Directory for the SQLite database (and backups, see BACKUP_DIR). Relative
# paths are resolved from the repo root (where this file lives), however the
# server is started. Default: ./data
# Docker ignores this: set FIRESIDE_DATA_PATH instead.
# The server makes this folder private to the user it runs as (0700, and its
# own files in it 0600), at every start.
# Because Docker ignores DATA_DIR and PORT, you can develop while Docker runs
# by using a sibling folder and another port for `pnpm dev`:
#   DATA_DIR=./data-dev
#   PORT=3101
# Never point `pnpm dev` and Docker at the same folder.
# The first time someone turns on two-factor authentication, the server makes
# DATA_DIR/fireside.key, which encrypts the 2FA secrets. It is never in a
# backup: keep a copy of it separately, not with the backups
# (docs/self-hosting.md, "Backups and restore").
DATA_DIR=./data

# --- Backups ---------------------------------------------------------------
# While the server runs it backs up the database every day at BACKUP_TIME, and
# when it starts if the newest backup is more than 24 hours old. Backups are
# safe while data comes in. Manual backup: `pnpm cli backup`. Restore (server
# stopped): `pnpm cli restore <file>`. See docs/self-hosting.md, "Backups and restore".
#
# Backups on the same disk do not survive a disk failure. Copy BACKUP_DIR to
# another disk or machine as well (or point BACKUP_DIR at one).

# Folder for backups. Relative paths are resolved from the repo root, like
# DATA_DIR. Docker ignores this and uses /data/backups (data/backups on the
# host). Default: <DATA_DIR>/backups
# The server makes this folder private too (0700, backups 0600): whatever
# copies the backups elsewhere must run as the same user.
# BACKUP_DIR=./data/backups

# true | false. Automatic backups while the server runs. `pnpm cli backup`
# works either way. Default: true.
BACKUP_ENABLED=true

# Time of the daily backup, HH:MM in TZ. Default: 04:00.
BACKUP_TIME=04:00

# How many backups to keep: the newest of each of the last N days, ISO weeks
# (Monday to Sunday) and months, in TZ. 0 turns a level off. The newest backup
# is always kept. Each backup is a full copy of the database (see Settings ->
# Server for the size). Defaults: 7 daily, 4 weekly, 6 monthly (about 17 files).
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# fatal | error | warn | info | debug | trace | silent. Default: info.
LOG_LEVEL=info

# --- Optional external services (all off by default) -------------------------
# The server never calls out unless a feature below is turned on AND
# USER_AGENT_CONTACT is set. Settings -> Server shows each source, its last
# fetch and its last error.

# Contact (email address or URL) for whoever runs this instance. Every external
# call sends the User-Agent "Fireside/<version> (+<contact>)", so API owners can
# reach you instead of blocking you. Optional features that call out stay off
# until this is set.
# USER_AGENT_CONTACT=you@example.com

# true | false. Fetch current Grand Exchange prices from the OSRS Wiki
# (prices.runescape.wiki), one request for all items, at most once an hour.
# The bank and the net worth are then valued at current prices; history and
# loot keep the prices from when they happened. Needs USER_AGENT_CONTACT.
# Default: false.
PRICES_ENABLED=false

# true | false. Fetch the collection log from RuneProfile (api.runeprofile.com)
# for the accounts you turn it on for under Settings -> OSRS accounts. Nothing
# is looked up for other accounts. Needs the RuneProfile plugin in RuneLite,
# and a RuneProfile profile is public: anyone can see its collection log,
# quests and diaries. Synced a few minutes after a session ends, every 6 hours
# and with "Sync now". Needs USER_AGENT_CONTACT. Default: false.
RUNEPROFILE_ENABLED=false

# Optional RuneProfile API key (ask in the RuneProfile Discord). Not needed:
# the server stays well inside the limit for requests without a key. Keep it
# secret.
# RUNEPROFILE_API_KEY=
