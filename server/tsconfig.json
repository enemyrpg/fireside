{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  // bin/ is plain JS so it runs without tsx in production installs.
  "include": [
    "src",
    "bin",
    "scripts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest.global-setup.ts",
    "drizzle.config.ts"
  ]
}
